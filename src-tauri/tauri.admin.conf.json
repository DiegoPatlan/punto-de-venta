{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Punto de Venta Admin",
  "version": "1.0.0",
  "identifier": "com.soporteit.puntoventa.admin",
  "build": {
    "frontendDist": "https://punto-de-ventasit.vercel.app",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Punto de Venta Admin",
        "url": "/admin/login?v=368367a",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/logo.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}